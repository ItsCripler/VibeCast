# Copy to .env for local Docker Compose. Do not commit the local .env file.
POSTGRES_DB=vibecast
POSTGRES_USER=vibecast_owner
POSTGRES_PASSWORD=replace-this-owner-password
VIBECAST_APP_DB_PASSWORD=replace-this-runtime-password
VIBECAST_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
VIBECAST_ENVIRONMENT=development
VIBECAST_COOKIE_SECURE=false
VIBECAST_FRONTEND_URL=http://localhost:5173
VIBECAST_ALLOWED_ORIGINS=http://localhost:5173

# Obtain a read API client ID from the official Jamendo developer portal.
VIBECAST_JAMENDO_CLIENT_ID=
VIBECAST_JAMENDO_MAX_TRACKS=1000
VIBECAST_JAMENDO_PAGE_SIZE=100
VIBECAST_JAMENDO_SEARCH_QUERIES=

# Optional listener sign-in. Staff login works independently of Google OAuth.
VIBECAST_GOOGLE_CLIENT_ID=
VIBECAST_GOOGLE_CLIENT_SECRET=
VIBECAST_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Set true only if the Essentia optional dependency is supported by your platform.
INSTALL_ESSENTIA=false
